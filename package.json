{
  "name": "qr-food-order-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "check:encoding": "node scripts/check-encoding.mjs",
    "test:fit-score-client": "node --experimental-strip-types tests/fitScoreClient.test.ts",
    "test:recommendation-client": "node --experimental-strip-types tests/recommendationService.test.ts",
    "test:dining-profile-storage": "node --experimental-strip-types tests/diningProfileStorage.test.ts",
    "test:dining-profile-ui": "node --experimental-strip-types tests/diningProfileUiPolicy.test.ts",
    "test:e2e:fit-score": "playwright test --config playwright.fit-score.config.ts",
    "test:e2e:recommendation": "playwright test --config playwright.recommendation.config.ts",
    "test:dining-visit-token": "node --experimental-strip-types tests/diningVisitToken.test.ts",
    "test:merchant-insight-access": "node --experimental-strip-types tests/merchantInsightAccess.test.ts",
    "test:customer-checkout-contact": "node --experimental-strip-types tests/customerCheckoutContact.test.ts",
    "test:customer-crm-access": "node --experimental-strip-types tests/customerCrmAccess.test.ts",
    "test:qr-download": "node --experimental-strip-types tests/qrDownload.test.ts",
    "test:merchant-insights-chart-data": "node --experimental-strip-types tests/merchantInsightsChartData.test.ts",
    "test:analytics-summary-data": "node --experimental-strip-types tests/analyticsSummaryData.test.ts",
    "test:recipe-ingredient-hydration": "node --experimental-strip-types tests/recipeIngredientHydration.test.ts",
    "test:owner-restaurant-archive": "node --experimental-strip-types tests/ownerRestaurantArchive.test.ts",
    "test:realtime-order-sync": "node --experimental-strip-types tests/realtimeOrderSync.test.ts",
    "test:realtime-order-telemetry": "node --experimental-strip-types tests/realtimeOrderTelemetry.test.ts",
    "test:ci": "npm run test:fit-score-client && npm run test:recommendation-client && npm run test:dining-profile-storage && npm run test:dining-profile-ui && npm run test:dining-visit-token && npm run test:merchant-insight-access && npm run test:merchant-insights-chart-data && npm run test:analytics-summary-data && npm run test:customer-checkout-contact && npm run test:customer-crm-access && npm run test:qr-download && npm run test:recipe-ingredient-hydration && npm run test:owner-restaurant-archive && npm run test:realtime-order-sync && npm run test:realtime-order-telemetry",
    "test:e2e:encoding": "playwright test tests/encoding-dashboard.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
